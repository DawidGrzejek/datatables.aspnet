<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core elements for DataTables.AspNet - Extended for .NET 10.0 with columnControl support.</Description>
    <Copyright>2014-2022 Anderson Matos (MIT License) - Extended 2026</Copyright>
    <AssemblyTitle>DataTables.AspNet.Core.Extended</AssemblyTitle>
    <NeutralLanguage>en-US</NeutralLanguage>
    <VersionPrefix>2.1.0</VersionPrefix>
    <Authors>Anderson Matos/Adhemar Soria Galvaro/IAM Extended</Authors>
    <AssemblyName>DataTables.AspNet.Core</AssemblyName>
    <PackageId>DataTables.AspNet.Core.Extended</PackageId>
    <PackageTags>DataTables;DataTables.Mvc;DataTables.AspNet;Mvc;AspNet;WebApi;columnControl</PackageTags>
    <PackageReleaseNotes>Extended for .NET 10.0 with full columnControl and DataTables extensions support.</PackageReleaseNotes>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DawidGrzejek/datatables.aspnet</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DawidGrzejek/datatables.aspnet</RepositoryUrl>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net45' ">
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
